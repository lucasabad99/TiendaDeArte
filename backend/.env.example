#################################################################
# .env.example — Copiá este archivo como ".env" y completá valores
#################################################################

# ---- Entorno ----
NODE_ENV=development

# ---- Servidor ----
PORT=8080

# ---- Front (CORS) ----
# Origen(es) del front que pueden llamar a la API, separados por coma.
CLIENT_URL=http://localhost:5173

# ---- Mail (formulario de contacto) ----
# En desarrollo podés dejar todo esto vacío: se usa Ethereal (SMTP de prueba)
# y en la consola aparece un link para ver cada mail.
# En producción es obligatorio. Ej. Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465
# y en SMTP_PASS una "contraseña de aplicación" (no la contraseña normal).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# A quién le llegan las consultas (mail de la artista)
CONTACT_TO=
# Remitente que se ve en el mail
MAIL_FROM=Taller de Arte <no-reply@tallerdearte.local>

# ---- Base de datos (MongoDB) ----
# Local: mongodb://127.0.0.1:27017/tienda_arte
# Atlas: pegá el connection string que te da Atlas.
MONGO_URI=mongodb://127.0.0.1:27017/tienda_arte

# ---- JWT (login) ----
# Generá uno largo y aleatorio:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambiame-por-un-string-largo-y-aleatorio
JWT_EXPIRES_IN=1d

# ---- Superadmin (solo lo usa "npm run seed") ----
# Es la única forma de crear el superadmin: la API nunca otorga ese rol.
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=

# ---- Mercado Pago (opcional) ----
# Sin token, los pedidos quedan "pendiente" y el pago se coordina a mano.
# Access Token de https://www.mercadopago.com.ar/developers/panel/app → tu app → Credenciales
# (de PRUEBA para desarrollar; las productivas de la artista para el sitio real).
MP_ACCESS_TOKEN=
# Minutos que queda reservado el stock de un pedido sin pagar
RESERVA_MINUTOS=30
# Solo producción: URL pública del backend, para que MP mande webhooks
# (ej. https://api.tutienda.com). En local no hace falta.
API_PUBLIC_URL=
# Solo producción: clave secreta de webhooks (panel de MP → Webhooks). Verifica la firma.
MP_WEBHOOK_SECRET=

# ---- Fotos (Cloudinary, opcional) ----
# Sin esto, las fotos de las obras se cargan pegando un link.
# Cloudinary → Settings → API Keys → "API environment variable":
# CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME
CLOUDINARY_URL=
# Carpeta dentro de Cloudinary (sirve para separar staging de producción)
CLOUDINARY_CARPETA=tienda-arte/obras
