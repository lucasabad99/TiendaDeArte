# Variables del front (Vite). En local van en .env.development; en Netlify, en el panel
# (Site configuration → Environment variables). Se leen al hacer el build.

# URL de la API (backend), terminada en /api/v1
VITE_API_URL=http://localhost:8080/api/v1

# true solo si el front y la API están en dominios distintos (ej. staging en netlify.app + onrender.com):
# el login usa un token en vez de la cookie, que el navegador bloquearía. En producción, con
# tutienda.com + api.tutienda.com, dejarlo en false.
VITE_AUTH_TOKEN=false
